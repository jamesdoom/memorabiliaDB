generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GradingRecommendation {
  YES
  NO
  MAYBE
  CONDITIONAL
}

enum CardStatus {
  NEW
  LISTED
  GRADED
}

enum SellerTransactionType {
  PURCHASE
  SALE
  REFUND
  RETURN
  ADJUSTMENT
}

model Card {
  id                    String   @id @default(uuid())
  slug                  String   @unique
  playerName            String
  sport                 String
  title                 String
  year                  Int
  manufacturer          String
  cardNumber            String?
  series                String?
  imageFrontUrl         String?
  imageBackUrl          String?
  rookie                Boolean
  goodConditionValue    Int?
  perfectConditionValue Int?
  valueSource           String?
  valueSourceUrl        String?
  valueConfidence       Int?
  valueNotes            String?
  lastValuedAt          DateTime?
  gradingProfitPotential Int?
  gradingRecommendation GradingRecommendation?
  status CardStatus @default(NEW)
  serialNumber          String?
  quantity              Int      @default(1)
  location              String?
  listingMarketplace    String?
  listingUrl            String?
  askingPriceCents      Int?
  listedAt              DateTime?
  soldAt                DateTime?
  importOrder           Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  sellerTransactions    SellerTransaction[]

  @@unique([playerName, year, manufacturer, title, cardNumber])
  @@index([playerName])
  @@index([lastValuedAt])
  
}

model SellerTransaction {
  id              String                @id @default(uuid())
  cardId          String?
  card            Card?                 @relation(fields: [cardId], references: [id], onDelete: SetNull)
  type            SellerTransactionType
  occurredAt      DateTime
  quantity        Int                   @default(1)
  amountCents     Int
  costBasisCents  Int                   @default(0)
  lotName         String?
  lotCardCount    Int?
  marketplace     String?
  orderId         String?
  marketplaceFees Int                   @default(0)
  shippingCost    Int                   @default(0)
  gradingCost     Int                   @default(0)
  suppliesCost    Int                   @default(0)
  notes           String?
  sourceFile      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([cardId])
  @@index([type])
  @@index([occurredAt])
  @@unique([type, orderId, occurredAt, amountCents])
}
