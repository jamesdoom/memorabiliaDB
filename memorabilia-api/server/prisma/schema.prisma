generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GradingRecommendation {
  YES
  NO
  MAYBE
  CONDITIONAL
}

enum CardStatus {
  NEW
  READY_TO_LIST
  LISTED
  SOLD
  SHIPPED
  GRADED
  ARCHIVED
}

enum InventoryLocationType {
  BOX
  SHELF
  BINDER
  CONSIGNMENT
  GRADING_SUBMISSION
  OTHER
}

enum GradingCompany {
  PSA
  SGC
  BECKETT
  OTHER
}

enum SellerTransactionType {
  PURCHASE
  SALE
  REFUND
  RETURN
  ADJUSTMENT
}

model Card {
  id                    String   @id @default(uuid())
  slug                  String   @unique
  playerName            String
  sport                 String
  title                 String
  year                  Int
  manufacturer          String
  cardNumber            String?
  series                String?
  imageFrontUrl         String?
  imageBackUrl          String?
  rookie                Boolean
  goodConditionValue    Int?
  perfectConditionValue Int?
  valueSource           String?
  valueSourceUrl        String?
  valueConfidence       Int?
  valueNotes            String?
  lastValuedAt          DateTime?
  gradingProfitPotential Int?
  gradingRecommendation GradingRecommendation?
  status CardStatus @default(NEW)
  serialNumber          String?
  quantity              Int      @default(1)
  location              String?
  locationType          InventoryLocationType?
  locationDetail        String?
  consignmentPartner    String?
  gradingSubmissionBatch String?
  gradingSubmissionBatchId String?
  gradingBatch          GradingSubmissionBatch? @relation(fields: [gradingSubmissionBatchId], references: [id], onDelete: SetNull)
  gradingCompany        GradingCompany?
  gradingServiceLevel   String?
  gradingSubmittedAt    DateTime?
  gradingReturnedAt     DateTime?
  gradingFeeCents       Int?
  gradingCertNumber     String?
  finalGrade            String?
  expectedGradedValueCents Int?
  gradingConfidence     Int?
  listingMarketplace    String?
  listingUrl            String?
  askingPriceCents      Int?
  listedAt              DateTime?
  soldAt                DateTime?
  importOrder           Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  sellerTransactions    SellerTransaction[]

  @@unique([playerName, year, manufacturer, title, cardNumber])
  @@index([playerName])
  @@index([lastValuedAt])
  @@index([gradingSubmissionBatchId])
  
}

model GradingSubmissionBatch {
  id            String         @id @default(uuid())
  name          String
  company       GradingCompany
  serviceLevel  String?
  submittedAt   DateTime?
  returnedAt    DateTime?
  notes         String?
  cards         Card[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([company])
  @@index([submittedAt])
  @@index([returnedAt])
}

model SellerTransaction {
  id              String                @id @default(uuid())
  cardId          String?
  card            Card?                 @relation(fields: [cardId], references: [id], onDelete: SetNull)
  type            SellerTransactionType
  occurredAt      DateTime
  quantity        Int                   @default(1)
  amountCents     Int
  costBasisCents  Int                   @default(0)
  lotName         String?
  lotCardCount    Int?
  marketplace     String?
  orderId         String?
  marketplaceFees Int                   @default(0)
  shippingCost    Int                   @default(0)
  gradingCost     Int                   @default(0)
  suppliesCost    Int                   @default(0)
  notes           String?
  sourceFile      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([cardId])
  @@index([type])
  @@index([occurredAt])
  @@unique([type, orderId, occurredAt, amountCents])
}
